[Unit]
Description=Project Leader private Telegram voice bridge (read-only audits)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/project-leader-telegram/telegram.env
ExecStart=/usr/bin/python3 /opt/project-leader-telegram/ops/telegram_vps_service.py
Restart=always
RestartSec=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
