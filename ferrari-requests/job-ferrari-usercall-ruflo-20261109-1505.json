{
  "version": 1,
  "id": "ferrari-usercall-ruflo-20261109-1505",
  "kind": "ruflo-host",
  "host": "ChatGPT",
  "roles": [
    {
      "id": "executor",
      "type": "coder"
    },
    {
      "id": "analista",
      "type": "researcher"
    },
    {
      "id": "verificador",
      "type": "reviewer"
    }
  ],
  "steps": [
    {
      "id": "formatar",
      "role": "executor",
      "kind": "invoke",
      "action": "jq-format-json",
      "input_from": "$input"
    },
    {
      "id": "rea",
      "role": "analista",
      "kind": "rea-mcp",
      "mcp_requests": [
        {
          "method": "tools/list"
        }
      ]
    },
    {
      "id": "revisar-json",
      "role": "verificador",
      "kind": "review",
      "input_from": "formatar",
      "acceptance": {
        "required_extensions": [
          ".json"
        ]
      }
    },
    {
      "id": "revisar-rea",
      "role": "verificador",
      "kind": "review",
      "input_from": "rea",
      "acceptance": {
        "required_extensions": [
          ".json"
        ]
      }
    }
  ],
  "max_parallel": 2,
  "input": {
    "name": "exemplo.json",
